CORS_ORIGINS="*"
# Single-upload limit and ephemeral artifact root
MAX_UPLOAD_MB=25
TEMP_ROOT="/tmp/anclora-purgedoc"
# Batch Document Queue Configuration
BATCH_MAX_DOCUMENTS=10
BATCH_MAX_FILE_SIZE_MB=25
BATCH_MAX_TOTAL_SIZE_MB=100
BATCH_MAX_CONCURRENT_DOCUMENTS=2
# Audit Retention Policies & Ephemeral Lifecycle
SESSION_TTL_MINUTES=60
SOURCE_DOCUMENT_TTL_MINUTES=15
INTERMEDIATE_ARTIFACT_TTL_MINUTES=15
VERIFIED_OUTPUT_TTL_MINUTES=60
AUDIT_ARTIFACT_TTL_MINUTES=60
BATCH_ARTIFACT_TTL_MINUTES=60
SSE_HISTORY_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=60
# Optional production-backed metadata mirror (raw document content is never persisted)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_TARGET=local

# Authentication & Closed Whitelist Access
APP_ENV=development
JWT_SECRET=your-secure-random-32-byte-hex-key-here
JWT_ALGORITHM=HS256
AUTH_ADMIN_EMAILS=admin@anclora.local
AUTH_WHITELIST_TOKEN_TTL_HOURS=72
AUTH_PASSWORD_MIN_LENGTH=12
ENABLE_DEV_FIXTURES=false

# Anclora Identity OIDC login (Wave 1 pilot). Fail-closed: unset/false keeps
# the existing whitelist/password login as the only path (backend/auth/oidc.py).
# Never auto-provisions a new PurgeDoc account — only links an OIDC login to an
# email that already has an active whitelist-provisioned account.
ANCLORA_IDENTITY_ENABLED=false
ANCLORA_IDENTITY_ISSUER_URL=
ANCLORA_IDENTITY_CLIENT_ID=purgedoc
ANCLORA_IDENTITY_CLIENT_SECRET=
ANCLORA_IDENTITY_REDIRECT_URI=http://localhost:8001/api/auth/anclora-identity/callback
ANCLORA_IDENTITY_POST_LOGIN_REDIRECT=/app
# Signs the short-lived (10 min) OIDC handshake cookie only, never the app session.
ANCLORA_IDENTITY_SESSION_SECRET=
