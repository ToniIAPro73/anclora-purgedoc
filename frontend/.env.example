# Anclora Purgedoc — frontend local configuration (names and safe placeholders only).
# Copy to frontend/.env.local (gitignored, mode 0600). Never commit real values.

# Base URL of the FastAPI backend; the app calls ${REACT_APP_BACKEND_URL}/api/...
REACT_APP_BACKEND_URL=http://localhost:8001

# Optional dev-server health endpoints (frontend/plugins/health-check). Default: disabled.
ENABLE_HEALTH_CHECK=false

# Legacy Emergent dev-server overlay (craco.config.js). "true" disables it locally.
DISABLE_EMERGENT_OVERLAY=true
